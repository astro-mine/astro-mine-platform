{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.astro-mine.org/core/mission/v0.1/mission.schema.json",
  "title": "Astro-Mine MissionSpec v0.1",
  "description": "The RFC-0001 mission-architecture schema hooks, reserved in Core as append-only, proto3-unknown-field-tolerant schema with NO mechanism (RM-P1-CORE-04; mission-model.md §2, §3). A single-surface-phase Mission is exactly today's campaign, so the schema is additive: existing consumers ignore `regime` and a one-phase MissionSpec validates with no author action. TrajectoryRef/Maneuver are descriptive design-time artifacts that omit actuator/thruster/closed-loop-guidance channels by schema (RFC-0001 R3). Canonical source of truth; the Pydantic models in astro_mine.core.mission.model mirror it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_version", "mission"],
  "properties": {
    "mission_version": { "const": "0.1" },
    "mission": { "$ref": "#/$defs/MissionSpec" }
  },
  "$defs": {
    "Regime": {
      "enum": ["launch_ascent", "interplanetary_transit", "proximity_orbit", "surface", "ascent_return", "earth_interface"]
    },
    "ManeuverType": {
      "enum": ["impulsive", "finite_burn", "low_thrust_arc"]
    },
    "Vec3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_hashes": { "type": "array", "items": { "type": "string" } },
        "code_version": { "type": ["string", "null"] },
        "toolchain_version": { "type": ["string", "null"] },
        "env_lockfile": { "type": ["string", "null"] },
        "seed": { "type": ["integer", "null"] }
      }
    },
    "ManeuverBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_delta_v_mps"],
      "properties": {
        "total_delta_v_mps": { "type": "number" },
        "time_of_flight_s": { "type": ["number", "null"] },
        "margin_mps": { "type": ["number", "null"] }
      }
    },
    "Maneuver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch_tdb_s", "delta_v_mps", "direction", "maneuver_type"],
      "properties": {
        "epoch_tdb_s": { "type": "number" },
        "delta_v_mps": { "type": "number" },
        "direction": { "$ref": "#/$defs/Vec3" },
        "maneuver_type": { "$ref": "#/$defs/ManeuverType" },
        "epoch": { "oneOf": [{ "$ref": "https://schemas.astro-mine.org/core/units/v0.1/units.schema.json#/$defs/Epoch" }, { "type": "null" }] }
      }
    },
    "ReferenceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch_tdb_s", "position_m", "velocity_mps"],
      "properties": {
        "epoch_tdb_s": { "type": "number" },
        "position_m": { "$ref": "#/$defs/Vec3" },
        "velocity_mps": { "$ref": "#/$defs/Vec3" },
        "epoch": { "oneOf": [{ "$ref": "https://schemas.astro-mine.org/core/units/v0.1/units.schema.json#/$defs/Epoch" }, { "type": "null" }] }
      }
    },
    "TrajectorySegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start_epoch_tdb_s", "end_epoch_tdb_s"],
      "properties": {
        "id": { "type": "string" },
        "start_epoch_tdb_s": { "type": "number" },
        "end_epoch_tdb_s": { "type": "number" },
        "kind": { "type": ["string", "null"] },
        "window": { "oneOf": [{ "$ref": "https://schemas.astro-mine.org/core/units/v0.1/units.schema.json#/$defs/EpochWindow" }, { "type": "null" }] }
      }
    },
    "TrajectoryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "frame"],
      "properties": {
        "id": { "type": "string" },
        "frame": { "type": "string" },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/TrajectorySegment" } },
        "maneuvers": { "type": "array", "items": { "$ref": "#/$defs/Maneuver" } },
        "reference_states": { "type": "array", "items": { "$ref": "#/$defs/ReferenceState" } },
        "feasibility_margin": { "type": ["number", "null"] },
        "provenance": {
          "oneOf": [{ "$ref": "#/$defs/Provenance" }, { "type": "null" }]
        },
        "frame_ref": { "oneOf": [{ "$ref": "https://schemas.astro-mine.org/core/units/v0.1/units.schema.json#/$defs/ReferenceFrame" }, { "type": "null" }] }
      }
    },
    "PhaseBoundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "condition": { "type": ["string", "null"] },
        "state_ref": { "type": ["string", "null"] }
      }
    },
    "Leg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "trajectory_ref": {
          "oneOf": [{ "$ref": "#/$defs/TrajectoryRef" }, { "type": "null" }]
        },
        "maneuver_budget": {
          "oneOf": [{ "$ref": "#/$defs/ManeuverBudget" }, { "type": "null" }]
        }
      }
    },
    "PhaseTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_phase", "to_phase"],
      "properties": {
        "from_phase": { "type": "string" },
        "to_phase": { "type": "string" },
        "terminal_state_ref": { "type": ["string", "null"] },
        "initial_state_ref": { "type": ["string", "null"] }
      }
    },
    "Phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "regime"],
      "properties": {
        "id": { "type": "string" },
        "regime": { "$ref": "#/$defs/Regime" },
        "environment_ref": { "type": ["string", "null"] },
        "assets_active": { "type": "array", "items": { "type": "string" } },
        "entry": {
          "oneOf": [{ "$ref": "#/$defs/PhaseBoundary" }, { "type": "null" }]
        },
        "exit": {
          "oneOf": [{ "$ref": "#/$defs/PhaseBoundary" }, { "type": "null" }]
        },
        "campaign_ref": { "type": ["string", "null"] },
        "legs": { "type": "array", "items": { "$ref": "#/$defs/Leg" } }
      }
    },
    "MissionConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget": { "type": ["number", "null"] },
        "schedule_s": { "type": ["number", "null"] },
        "launch_capacity_kg": { "type": ["number", "null"] },
        "export_gated": { "type": "boolean" }
      }
    },
    "MissionSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "phases": { "type": "array", "items": { "$ref": "#/$defs/Phase" } },
        "fleet": { "type": "array", "items": { "type": "string" } },
        "objective_ref": { "type": ["string", "null"] },
        "constraints": {
          "oneOf": [{ "$ref": "#/$defs/MissionConstraints" }, { "type": "null" }]
        },
        "provenance": {
          "oneOf": [{ "$ref": "#/$defs/Provenance" }, { "type": "null" }]
        }
      }
    }
  }
}
