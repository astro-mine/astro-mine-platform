{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.astro-mine.org/core/policy/v0.1/policy_package.schema.json",
  "title": "Astro-Mine PolicyPackage v0.1",
  "description": "The typed metadata sidecar for an exported ONNX policy (RM-P1-CORE-01; core.md §3; learn.md). An ONNX graph plus this sidecar is the portable policy artifact Learn exports, Mind hosts (ONNX Runtime), Guard wraps, and Bench scores — so a learned policy loads and satisfies the Core Policy/Planner contract through the standard interface. Canonical source of truth; the Pydantic models in astro_mine.core.policy.model mirror it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_package_version", "policy_package"],
  "properties": {
    "policy_package_version": { "const": "0.1" },
    "policy_package": { "$ref": "#/$defs/PolicyPackage" }
  },
  "$defs": {
    "TensorDType": {
      "enum": ["float32", "float64", "int32", "int64", "uint8", "bool"]
    },
    "TensorSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dtype", "shape"],
      "properties": {
        "name": { "type": "string" },
        "dtype": { "$ref": "#/$defs/TensorDType" },
        "shape": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "ModelRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "uri": { "type": ["string", "null"] },
        "opset": { "type": ["integer", "null"] }
      }
    },
    "IoSignature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/TensorSpec" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/TensorSpec" } },
        "observation_space": { "type": "object" },
        "action_space": { "type": "object" }
      }
    },
    "PolicyAssumptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comms_observability": { "type": ["string", "null"] },
        "action_bounds": { "type": "object" },
        "surrogate_fidelity_caveats": { "type": "array", "items": { "type": "string" } },
        "deterministic": { "type": "boolean" }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_hashes": { "type": "array", "items": { "type": "string" } },
        "code_version": { "type": ["string", "null"] },
        "toolchain_version": { "type": ["string", "null"] },
        "env_lockfile": { "type": ["string", "null"] },
        "seed": { "type": ["integer", "null"] }
      }
    },
    "PolicyPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "onnx_model"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "onnx_model": { "$ref": "#/$defs/ModelRef" },
        "io_signature": {
          "oneOf": [{ "$ref": "#/$defs/IoSignature" }, { "type": "null" }]
        },
        "core_interfaces": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "assumptions": {
          "oneOf": [{ "$ref": "#/$defs/PolicyAssumptions" }, { "type": "null" }]
        },
        "provenance": {
          "oneOf": [{ "$ref": "#/$defs/Provenance" }, { "type": "null" }]
        }
      }
    }
  }
}
