{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Faithful subset of the OCI Image Manifest spec v1.1 (github.com/opencontainers/image-spec/blob/main/schema/image-manifest-schema.json), enough to gate astro-mine asset + signature-referrer manifests hermetically in CI. The authoritative check is the `oras` CI step; this is the fast, binary-free baseline.",
  "type": "object",
  "required": ["schemaVersion", "mediaType", "artifactType", "config", "layers"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "mediaType": { "const": "application/vnd.oci.image.manifest.v1+json" },
    "artifactType": { "type": "string", "minLength": 1 },
    "config": { "$ref": "#/$defs/descriptor" },
    "layers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/descriptor" } },
    "subject": { "$ref": "#/$defs/descriptor" },
    "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "$defs": {
    "descriptor": {
      "type": "object",
      "required": ["mediaType", "digest", "size"],
      "properties": {
        "mediaType": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "artifactType": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
